local secAutomation = tabMain:Section("ระบบอัตโนมัติ")

-- ฟังก์ชัน Auto Goal
secAutomation:Toggle("เปิดใช้งาน ยิงประตูอัตโนมัติ (Auto Goal)", false, "ToggleAutoGoal", function(state)
    Settings.AutoGoal = state
