secBall:Toggle("เปิดใช้งาน ขยาย Hitbox ตัวละคร", false, "ToggleHitbox", function(state)
    Settings.Hitbox = state
end)

secBall:Slider("ขนาด Hitbox (1 - 10)", 1, 10, 1, 1, "SliderHitboxSize", function(val)
    Settings.HitboxSize = val
end)

local secVisual = tabMain:Section("ระบบการมองเห็น")

