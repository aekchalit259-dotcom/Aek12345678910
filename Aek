local SolarisLib = loadstring(game:HttpGet("https://solarishub.dev/SolarisLib.lua"))()

-- บริการพื้นฐานของ Roblox
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- ตัวแปรเก็บสถานะการตั้งค่า
local Settings = {
    BigBall = false,
    BallSize = 1,
    Hitbox = false,
    HitboxSize = 1,
    ESP = false,
    AutoGoal = false,
    WalkSpeedToggle = false,
    WalkSpeed = 16,
    FlyToggle = false,
    FlySpeed = 50
}

-- ตัวแปรสำหรับระบบบิน
local Flying = false
local FlyBodyVelocity = nil
local FlyBodyGyro = nil

-- สร้างหน้าต่าง GUI
local win = SolarisLib:New({
    Name = "Blue Lock Rivals Hub",
    FolderToSave = "BLR_SolarisConfig"
})

-- แถบเมนูหลัก
local tabMain = win:Tab("ฟังก์ชันหลัก")
